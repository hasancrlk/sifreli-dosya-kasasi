# VaultCore Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://vaultcore:vaultcore_secret@localhost:5432/vaultcore_db

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=production
DEBUG=false

# File Storage
ENCRYPTED_FILES_DIR=./encrypted_files

# Security
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# KDF Configuration (Argon2id)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# File Limits
MAX_FILE_SIZE_MB=100
