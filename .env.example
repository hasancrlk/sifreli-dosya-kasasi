# VaultCore — copy to .env and change every "change-me" value.
# Generate secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=postgresql+asyncpg://vaultcore:change-me@localhost:5432/vaultcore_db
API_KEY=change-me

APP_ENV=production
DEBUG=false

ENCRYPTED_FILES_DIR=./encrypted_files
MAX_FILE_SIZE_MB=100
CLEANUP_INTERVAL_MINUTES=60

# Use redis:// when running multiple workers
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DOWNLOAD=5/minute
RATE_LIMIT_UPLOAD=10/minute

MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# Argon2id (for new files; stored per file)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
KDF_MAX_CONCURRENCY=4

# Docker Compose only
POSTGRES_USER=vaultcore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vaultcore_db
